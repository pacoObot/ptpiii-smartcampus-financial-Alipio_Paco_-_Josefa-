# Node environment
NODE_ENV=development
API_PORT=4100
WEB_PORT=3000

# Base de Dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_campus_db?schema=public"

# Segurança e Autenticação
JWT_SECRET="smart-campus-super-secret-key-ptp-iii-2026"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_SECRET="smart-campus-refresh-token-secret-2026"
REFRESH_TOKEN_EXPIRES_IN="7d"

# MQTT Broker (para IoT e Comunicação em Tempo Real)
MQTT_BROKER_URL="mqtt://localhost:1883"

# Logs e Auditoria
LOG_LEVEL="debug"
