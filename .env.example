# Node environment
NODE_ENV=development
API_PORT=4100
WEB_PORT=3000

# Base de Dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_campus_db?schema=public"

# Segurança e Autenticação
JWT_SECRET="substituir-por-segredo-local-aleatorio"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_SECRET="substituir-por-outro-segredo-local-aleatorio"
REFRESH_TOKEN_EXPIRES_IN="7d"

# MQTT Broker (para IoT e Comunicação em Tempo Real)
MQTT_BROKER_URL="mqtt://localhost:1883"

# Logs e Auditoria
LOG_LEVEL="debug"

# API externa do grupo de Notificacoes — contrato proposto em docs/integracao-notificacoes.md
# URL completa do POST receptor, por exemplo https://host-do-grupo/api/v1/notifications
# Sem URL ou token, os avisos ficam PENDING e nao sao enviados.
NOTIFICATIONS_API_URL=
NOTIFICATIONS_API_TOKEN=
NOTIFICATIONS_TIMEOUT_MS=5000
NOTIFICATIONS_POLL_INTERVAL_MS=30000
